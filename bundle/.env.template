# Launcher-generated .env for the user bundle. The launcher fills every REQUIRED value.
# Used with: docker compose -p obsopt -f compose.yml [-f compose.gpu.yml] --env-file .env up -d

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Release being run (matches the GHCR image tags, no leading "v").
OO_VERSION=0.0.0
# Vault on the host (forward slashes, even on Windows). Subdirs _reports, _workspace and
# resources MUST exist before `up` (launcher creates them) or Docker makes them root-owned.
HOST_VAULT_PATH=/home/user/ObsidianOptimizer/vault
# Random, launcher-generated (e.g. 32 hex bytes).
POSTGRES_PASSWORD=dummy-postgres-password
MCP_API_TOKEN=dummy-mcp-token
# App login. Password chosen by the user in the wizard.
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=dummy-app-password
# Remember-me signing key — must stay stable across restarts/updates (random, generated once).
APP_AUTH_REMEMBER_KEY=dummy-remember-key
# From POST /v1/claim on the registry.
CLOUDFLARE_TUNNEL_TOKEN=dummy-tunnel-token

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# Local port the desktop window loads (bound to 127.0.0.1 only).
OO_LOCAL_PORT=8090
# CPU ceiling for the embedder container (cores).
OO_EMBEDDER_CPUS=2
# Embedder device for the base (CPU) bundle. The GPU overlay uses EMBED_DEVICE_GPU (default auto).
EMBED_DEVICE=cpu
# EMBED_DEVICE_GPU=auto

# LLM provider keys (stay in .env for v1). Any subset; claude-cli is disabled in the bundle.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GITHUB_MODELS_TOKEN=
ANTHROPIC_API_KEY=

# Extra hosts the /mcp endpoint accepts — set to <name>.obsidianoptimizer.uk by the launcher.
MCP_ALLOWED_HOSTS=
# Optional agent-escalation WebSocket token (blank = disabled).
AGENT_WS_TOKEN=

# Google Drive backup (per-user OAuth). Redirect = the registry relay callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://registry.obsidianoptimizer.uk/oauth/google/callback
SYNC_PASSPHRASE=

# Tunables (defaults sized for a Docker Desktop VM with ~8GB; see FLOWS.md)
# INGEST_V2=off
# WHISPER_MODEL=small   # small ~1GB RAM; distil-large-v3 needs ~4GB more
# SYNTH_MODEL=haiku
# CARDS_ENABLED=true
