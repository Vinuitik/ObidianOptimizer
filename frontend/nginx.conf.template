# Single plain-HTTP server block. The app is reachable ONLY through the Cloudflare
# tunnel: cloudflared (container) → frontend:8081 over the docker network.
# Cloudflare terminates REAL TLS at its edge, so this is plain HTTP — no local
# cert, no :80 redirect, no :443 self-signed edge (both removed: over-engineered
# for a single-user tunnel-only deployment, and the cause of the port confusion).
# No host ports are published for this service → nothing on localhost or the LAN.

# Rate-limit zones (http context)
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api:10m   rate=30r/s;

server {
    listen 8081;

    # ── Security headers ─────────────────────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;   # allow our own pages to <embed> our PDFs; still blocks other sites
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # style-src 'unsafe-inline': Milkdown/Framer Motion set inline styles.
    # img/media blob:: pasted-but-unsaved files previewed via blob URLs.
    # img-src https:: notes legitimately embed remote images (e.g. wiki figures) —
    #   allow any https image host. Trade-off: the remote host sees your IP when the
    #   image loads (single-user personal tool → acceptable). Tighten if that matters.
    # object-src 'self': allows <embed> for inline PDF viewing from same-origin paths.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; object-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;

    # ── Auth endpoint — strict brute-force limit (5/min per IP) ──────────────
    location = /api/login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass         http://backend:8084/login;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        # All traffic arrives via Cloudflare HTTPS → tell Spring so the session
        # cookie is marked Secure (server.forward-headers-strategy=framework).
        proxy_set_header   X-Forwarded-Proto https;
    }

    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass         http://backend:8084/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        client_max_body_size 100m;   # match Spring multipart limit (default 1m would 413 uploads)
    }

    # ── MCP endpoint — Model Context Protocol over streamable HTTP ───────────
    # Auth is a URL QUERY TOKEN, not a header — because the claude.ai website
    # connector can't send custom headers and, if it gets a 401, falls into an
    # OAuth flow we don't implement (hits a nonexistent /authorize). So the client
    # connects to  https://obsidianoptimizer.uk/mcp?token=<MCP_API_TOKEN>  and nginx
    # gates on ?token=: every request carries it → always 200 → the website never
    # sees a 401 → never starts OAuth. Same pattern as the habitTracker Caddy rule.
    # nginx then swaps the query token for the X-API-Key HEADER the embedder wants.
    # ${MCP_API_TOKEN} is filled at container start by envsubst (NGINX_ENVSUBST_FILTER
    # pins it to this one var), so the secret stays in .env, never in git.
    # Trade-off: the token rides in the URL (visible in access logs / history) — fine
    # for single-user. streamable-HTTP needs HTTP/1.1 keep-alive + unbuffered proxying
    # + long read timeout; the SDK host-validates so $host must be in MCP_ALLOWED_HOSTS.
    location /mcp {
        # Reject anything whose ?token= query param doesn't match. if+return is the
        # nginx-safe use of `if` (no side effects); on match, falls through to proxy.
        if ($arg_token != "${MCP_API_TOKEN}") { return 401; }

        limit_req zone=api burst=60 nodelay;
        proxy_pass              http://embedder:8000;
        proxy_http_version      1.1;
        proxy_set_header        Connection "";
        proxy_set_header        Host $host;
        proxy_set_header        X-Real-IP $remote_addr;
        proxy_set_header        X-Forwarded-Proto https;
        proxy_set_header        X-API-Key "${MCP_API_TOKEN}";
        proxy_buffering         off;
        proxy_request_buffering off;
        proxy_read_timeout      300s;
        client_max_body_size    10m;
    }

    # Agent-escalation WebSocket (AGENT_ESCALATION.md). Same token-in-URL auth as /mcp — the
    # extension connects to  wss://obsidianoptimizer.uk/agent-ws?token=<AGENT_WS_TOKEN>  so the
    # escalation agent can drive its browser tools. WS upgrade proxied to the (loopback) embedder.
    location /agent-ws {
        if ($arg_token != "${AGENT_WS_TOKEN}") { return 401; }
        proxy_pass          http://embedder:8000;
        proxy_http_version  1.1;
        proxy_set_header    Upgrade $http_upgrade;
        proxy_set_header    Connection "upgrade";
        proxy_set_header    Host $host;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
    }

    # ── Static media — served by nginx directly for range-request support ────────
    # vault/resources/ subdirs (images, videos, audio, pdf) → embedded note media
    location /vault-media/ {
        alias /vault-resources/;
    }

    # vault/_workspace/ → learn-page workspace files (PDF, video, audio)
    location /workspace/ {
        alias /workspace/;
    }

    location / {
        root       /usr/share/nginx/html;
        try_files  $uri $uri/ /index.html;
    }
}
