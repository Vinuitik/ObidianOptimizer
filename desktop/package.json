{
  "name": "obsidian-optimizer-desktop",
  "productName": "Obsidian Optimizer",
  "version": "1.0.0",
  "description": "Obsidian Optimizer launcher - runs the self-host docker bundle, with the quit-breaker close-guard.",
  "main": "main.js",
  "author": "Obsidian Optimizer",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "uk.obsidianoptimizer.desktop",
    "productName": "Obsidian Optimizer",
    "files": [
      "main.js",
      "preload.js",
      "quotes.json",
      "icon.png",
      "lib/**/*",
      "wizard/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "ObsidianOptimizer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Utility",
      "artifactName": "ObsidianOptimizer-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "ObsidianOptimizer-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
