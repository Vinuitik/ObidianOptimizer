{
  "manifest_version": 3,
  "name": "Obsidian Optimizer — Clip & Download",
  "version": "0.1.0",
  "description": "Make a note from any page, or queue a video/playlist for offline download — without opening the app.",
  "action": {
    "default_title": "Obsidian Optimizer",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://localhost/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "obsidian-optimizer@obsidianoptimizer.uk",
      "strict_min_version": "121.0"
    }
  }
}
