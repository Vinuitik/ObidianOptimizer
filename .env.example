# Copy this file to .env and set your vault path.
# Use forward slashes even on Windows.
HOST_VAULT_PATH=C:/Users/YourName/path/to/your/vault
# resources/ and _workspace/ are derived from HOST_VAULT_PATH automatically.

# App login credentials (required — compose refuses to start without a password)
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=pick-a-strong-password

# MCP server auth (required) — X-API-Key for the /mcp endpoint on the embedder.
# Generate with: openssl rand -hex 32
MCP_API_TOKEN=generate-a-32-byte-hex-token

# Cloudflare Tunnel token (optional — only used with: docker compose --profile tunnel up)
# Create a tunnel in Cloudflare Zero Trust and point its public hostname at http://frontend:8081
CLOUDFLARE_TUNNEL_TOKEN=

# Sync / Google Drive (all optional — sync is disabled when blank/placeholder)
SYNC_PASSPHRASE=changeme
# Cron schedule for automatic upload (default: every 6 hours)
SYNC_UPLOAD_CRON=0 0 */6 * * *

# ── Google Drive OAuth (per-user backup) ────────────────────────────────────
# Multi-user backup: each user connects their OWN Google account in-app, so the
# files land in their Drive (the old service-account model had no storage quota).
# Setup: Google Cloud Console → Web-application OAuth client, scope
# .../auth/drive.file, consent screen published to Production.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Redirect URI registered on the OAuth client — MUST match exactly.
#   prod: https://obsidianoptimizer.uk/api/sync/oauth/callback
#   dev:  http://localhost:8084/api/sync/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=https://obsidianoptimizer.uk/api/sync/oauth/callback

# Deprecated — service-account backup (broken since Google's policy change).
# Kept as placeholders only so docker-compose interpolation doesn't error.
GOOGLE_DRIVE_FOLDER_ID=placeholder
GOOGLE_SERVICE_ACCOUNT_JSON=placeholder

# ── LLM provider keys (host-wrapper router) ─────────────────────────────────
# Single source of truth: the host-wrapper loads THIS file. All keys optional —
# a provider without a key is skipped. Free tiers are tried first; Claude
# (API key / CLI subscription) is only used when everything else is exhausted.

# Gemini — aistudio.google.com → "Get API key". Free: 15 RPM / 1500 req-day.
# Do NOT enable billing on the Google Cloud project or the free tier vanishes.
GEMINI_API_KEY=

# GitHub Models — github.com → Settings → Developer settings → PAT (models:read).
# Free: ~15 RPM with a daily cap.
GITHUB_MODELS_TOKEN=

# Mistral La Plateforme — console.mistral.ai → API keys. Free: ~1 req/sec.
MISTRAL_API_KEY=

# Groq — console.groq.com → API keys. Free: ~30 RPM.
GROQ_API_KEY=

# DeepSeek — platform.deepseek.com. PAID but very cheap; text-only. Optional.
DEEPSEEK_API_KEY=

# Anthropic API — console.anthropic.com. Vision fallback of last resort.
ANTHROPIC_API_KEY=

# Optional router overrides (defaults shown in host-wrapper/llm_router.py):
# LLM_VISION_PRIORITY=gemini,github,mistral,groq,anthropic
# LLM_TEXT_PRIORITY=groq,github,mistral,deepseek,gemini,claude-cli
# GEMINI_MODEL= / GITHUB_MODELS_MODEL= / MISTRAL_MODEL= / GROQ_TEXT_MODEL= /
# GROQ_VISION_MODEL= / DEEPSEEK_MODEL= / ANTHROPIC_MODEL= / SYNTH_MODEL=
