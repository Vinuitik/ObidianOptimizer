.claude/

# Local config (vault path, vault location choice — never commit)
.env
.vault-ack

# Self-signed TLS certs (generated by start.ps1)
certs/

# Python
__pycache__/
.pytest_cache/
.venv/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/


# Generated Firefox extension build (see build-firefox-extension.ps1)
extension-firefox/

# Signed .xpi + updates.json published by deploy-extension.sh (served at /ext/)
ext-dist/
# npx/web-ext download cache reused across signings (keeps re-signs fast)
.web-ext-cache/
*.bak
*.bak.*

# Unified test runner outputs (linux_scripts/test.sh)
test-results/
